city_data : city.vallenar
{
    city_name: "Vallenar"
    city_name_localized: "@@vallenar@@"
    country: chile

    map_x_offsets[]: 0
    map_x_offsets[]: 0
    map_x_offsets[]: 0
    map_x_offsets[]: -10
    map_x_offsets[]: 0
    map_x_offsets[]: 0
    map_x_offsets[]: -20
    map_x_offsets[]: -15

    map_y_offsets[]: 0
    map_y_offsets[]: 0
    map_y_offsets[]: 25
    map_y_offsets[]: -10
    map_y_offsets[]: -5
    map_y_offsets[]: -15
    map_y_offsets[]: -15
    map_y_offsets[]: -15

    # Coordenadas en mapa SCS (escala 1:19)
    # Región: Región de Atacama (III)
    # Posición estimada X/Z
    vehicle_brands[]: "scania"
    vehicle_brands[]: "volvo"
}
