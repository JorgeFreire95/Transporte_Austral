# Sistema de Patentes de Chile - Formato Oficial Registro Civil (BB·BB-00)
# Excluye vocales (A, E, I, O, U) y letras confusas (M, N, Ñ, Q)

license_plate_data : .lp.truck
{
    type: truck

    # Formato estándar de patente chilena: 4 consonantes y 2 dígitos
    templates[]: "01·23-45"
    templates[]: "01·23 45"

    # Primera y segunda consonante
    def0[]: "B"
    def0[]: "C"
    def0[]: "D"
    def0[]: "F"
    def0[]: "G"
    def0[]: "H"
    def0[]: "J"
    def0[]: "K"
    def0[]: "L"
    def0[]: "P"
    def0[]: "R"
    def0[]: "S"
    def0[]: "T"
    def0[]: "V"
    def0[]: "W"
    def0[]: "X"
    def0[]: "Y"
    def0[]: "Z"

    def1[]: "B"
    def1[]: "C"
    def1[]: "D"
    def1[]: "F"
    def1[]: "G"
    def1[]: "H"
    def1[]: "J"
    def1[]: "K"
    def1[]: "L"
    def1[]: "P"
    def1[]: "R"
    def1[]: "S"
    def1[]: "T"
    def1[]: "V"
    def1[]: "W"
    def1[]: "X"
    def1[]: "Y"
    def1[]: "Z"

    # Tercera y cuarta consonante
    def2[]: "B"
    def2[]: "C"
    def2[]: "D"
    def2[]: "F"
    def2[]: "G"
    def2[]: "H"
    def2[]: "J"
    def2[]: "K"
    def2[]: "L"
    def2[]: "P"
    def2[]: "R"
    def2[]: "S"
    def2[]: "T"
    def2[]: "V"
    def2[]: "W"
    def2[]: "X"
    def2[]: "Y"
    def2[]: "Z"

    def3[]: "B"
    def3[]: "C"
    def3[]: "D"
    def3[]: "F"
    def3[]: "G"
    def3[]: "H"
    def3[]: "J"
    def3[]: "K"
    def3[]: "L"
    def3[]: "P"
    def3[]: "R"
    def3[]: "S"
    def3[]: "T"
    def3[]: "V"
    def3[]: "W"
    def3[]: "X"
    def3[]: "Y"
    def3[]: "Z"

    # Dígitos numéricos (00 al 99)
    def4[]: "0"
    def4[]: "1"
    def4[]: "2"
    def4[]: "3"
    def4[]: "4"
    def4[]: "5"
    def4[]: "6"
    def4[]: "7"
    def4[]: "8"
    def4[]: "9"

    def5[]: "0"
    def5[]: "1"
    def5[]: "2"
    def5[]: "3"
    def5[]: "4"
    def5[]: "5"
    def5[]: "6"
    def5[]: "7"
    def5[]: "8"
    def5[]: "9"
}

